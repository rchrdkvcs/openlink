{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "vue"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "unicorn/consistent-function-scoping": "off"
  },
  "ignorePatterns": ["public/build/**"],
  "env": {
    "builtin": true
  }
}
