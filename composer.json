{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "openlink/openlink",
    "type": "project",
    "description": "Self-hosted URL management for short links, domains, QR codes, folders, and analytics.",
    "keywords": ["openlink", "url-shortener", "links", "laravel"],
    "license": "MIT",
    "require": {
        "php": "^8.5.12",
        "bacon/bacon-qr-code": "^3.1.1",
        "inertiajs/inertia-laravel": "^3.5.1",
        "laravel/framework": "^13.38.0",
        "laravel/octane": "^2.22.0",
        "laravel/sanctum": "^4.3.3",
        "laravel/socialite": "^5.31.0",
        "laravel/tinker": "^3.0.2",
        "pragmarx/google2fa": "^9.1.0",
        "predis/predis": "^3.7.0",
        "socialiteproviders/discord": "^4.2.0",
        "symfony/http-client": "^8.1.9",
        "tightenco/ziggy": "^2.6.5"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24.1",
        "laravel/breeze": "^2.4.2",
        "laravel/pail": "^1.2.7",
        "laravel/pao": "^1.1.5",
        "laravel/pint": "^1.32.1",
        "mockery/mockery": "^1.6.15",
        "nunomaduro/collision": "^8.9.5",
        "phpunit/phpunit": "^13.4.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "setup": [
            "@php scripts/prepare-local.php",
            "docker compose -f docker/compose.dev.yml up -d",
            "composer install",
            "@php artisan migrate --force",
            "pnpm install --frozen-lockfile",
            "pnpm run build"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "pnpm exec concurrently -c \"#93c5fd,#c4b5fd,#fdba74\" \"php artisan serve --host=127.0.0.1 --port=8000\" \"php artisan queue:listen --tries=1 --timeout=0\" \"pnpm run dev\" --names=server,queue,vite --kill-others"
        ],
        "test": [
            "@php artisan config:clear --ansi @no_additional_args",
            "@php artisan test"
        ],
        "format": "@php vendor/bin/pint",
        "lint": "@php vendor/bin/pint --test",
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php -r \"if (is_file('bootstrap/cache/packages.php')) unlink('bootstrap/cache/packages.php'); if (is_file('bootstrap/cache/services.php')) unlink('bootstrap/cache/services.php');\"",
            "@php artisan view:clear --ansi",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "pre-package-uninstall": [
            "Illuminate\\Foundation\\ComposerScripts::prePackageUninstall"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/breeze",
                "laravel/pail",
                "laravel/pao",
                "nunomaduro/collision"
            ]
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
