{
  "$schema": "https://www.schemastore.org/package.json",
  "name": "openlink",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "vue-tsc && vite build",
    "check": "pnpm run lint && pnpm run format:check && pnpm run typecheck && pnpm run test",
    "dev": "vite",
    "format": "oxfmt resources/js resources/css vite.config.js vitest.config.js tailwind.config.js tsconfig.json components.json package.json .oxlintrc.json .oxfmtrc.json",
    "format:check": "pnpm run format --check",
    "lint": "oxlint resources/js --deny-warnings",
    "lint:fix": "pnpm run lint --fix",
    "test": "vitest run",
    "typecheck": "vue-tsc --noEmit"
  },
  "dependencies": {
    "@lucide/vue": "^1.48.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "radix-vue": "^1.9.17",
    "tailwind-merge": "^3.7.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@inertiajs/vue3": "^3.7.1",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/vite": "^4.3.3",
    "@vitejs/plugin-vue": "^6.0.9",
    "concurrently": "^10.0.5",
    "laravel-vite-plugin": "^3.2.0",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.3.1",
    "vitest": "^5.0.3",
    "vue": "^3.5.43",
    "vue-tsc": "^3.3.11"
  },
  "packageManager": "pnpm@12.6.0"
}
